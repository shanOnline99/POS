datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  manager
  cashier
}

enum MovementType {
  sale
  purchase_order
  return
  adjustment
  transfer
  damage
}

enum OrderStatus {
  draft
  parked
  completed
  voided
  refunded
}

enum PaymentMethod {
  cash
  card
  qr_code
  credit
  voucher
}

enum ShiftStatus {
  open
  closed
}

model Store {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @db.VarChar(150)
  code                String               @unique @db.VarChar(50)
  address             String?              @db.Text
  phone               String?              @db.VarChar(30)
  taxIdentifier       String?              @map("tax_identifier") @db.VarChar(50)
  currencyCode        String               @default("USD") @map("currency_code") @db.VarChar(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  users               User[]
  categories          Category[]
  products            Product[]
  customers           Customer[]
  orders              Order[]
  cashShifts          CashShift[]
  inventoryMovements  InventoryMovement[]

  @@map("stores")
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  storeId      String      @map("store_id") @db.Uuid
  name         String      @db.VarChar(100)
  email        String?     @unique @db.VarChar(150)
  passcodeHash String      @map("passcode_hash") @db.VarChar(255)
  role         Role        @default(cashier)
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz

  store        Store       @relation(fields: [storeId], references: [id])
  orders       Order[]
  cashShifts   CashShift[]

  @@map("users")
}

model TaxRate {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(50)
  ratePercent Decimal          @map("rate_percent") @db.Decimal(5, 2)
  isInclusive Boolean          @default(false) @map("is_inclusive")
  isActive    Boolean          @default(true) @map("is_active")

  variants    ProductVariant[]

  @@map("tax_rates")
}

model Category {
  id          String      @id @default(uuid()) @db.Uuid
  storeId     String      @map("store_id") @db.Uuid
  name        String      @db.VarChar(100)
  parentId    String?     @map("parent_id") @db.Uuid

  store       Store       @relation(fields: [storeId], references: [id])
  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

model Product {
  id          String           @id @default(uuid()) @db.Uuid
  storeId     String           @map("store_id") @db.Uuid
  categoryId  String?          @map("category_id") @db.Uuid
  name        String           @db.VarChar(200)
  description String?          @db.Text
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  store       Store            @relation(fields: [storeId], references: [id])
  category    Category?        @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id                 String              @id @default(uuid()) @db.Uuid
  productId          String              @map("product_id") @db.Uuid
  taxRateId          String?             @map("tax_rate_id") @db.Uuid
  sku                String              @unique @db.VarChar(64)
  barcode            String?             @unique @db.VarChar(64)
  name               String              @default("Standard") @db.VarChar(100)
  costPrice          Decimal             @default(0.0000) @map("cost_price") @db.Decimal(12, 4)
  retailPrice        Decimal             @default(0.0000) @map("retail_price") @db.Decimal(12, 4)
  unitOfMeasure      String              @default("pcs") @map("unit_of_measure") @db.VarChar(20)
  trackInventory     Boolean             @default(true) @map("track_inventory")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxRate            TaxRate?            @relation(fields: [taxRateId], references: [id])
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  @@map("product_variants")
}

model InventoryMovement {
  id            String          @id @default(uuid()) @db.Uuid
  variantId     String          @map("variant_id") @db.Uuid
  storeId       String          @map("store_id") @db.Uuid
  quantityDelta Decimal         @map("quantity_delta") @db.Decimal(12, 3)
  movementType  MovementType    @map("movement_type")
  referenceId   String?         @map("reference_id") @db.Uuid
  notes         String?         @db.Text
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz

  variant       ProductVariant  @relation(fields: [variantId], references: [id])
  store         Store           @relation(fields: [storeId], references: [id])

  @@map("inventory_movements")
}

model Customer {
  id            String    @id @default(uuid()) @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  name          String    @db.VarChar(150)
  phone         String?   @db.VarChar(30)
  email         String?   @db.VarChar(150)
  loyaltyPoints Int       @default(0) @map("loyalty_points")
  creditLimit   Decimal   @default(0.00) @map("credit_limit") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  store         Store     @relation(fields: [storeId], references: [id])
  orders        Order[]

  @@map("customers")
}

model Order {
  id             String       @id @default(uuid()) @db.Uuid
  storeId        String       @map("store_id") @db.Uuid
  cashierId      String       @map("cashier_id") @db.Uuid
  customerId     String?      @map("customer_id") @db.Uuid
  orderNumber    String       @unique @map("order_number") @db.VarChar(50)
  status         OrderStatus  @default(completed)
  subtotalAmount Decimal      @default(0.00) @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount Decimal      @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount      Decimal      @default(0.00) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount    Decimal      @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  store          Store        @relation(fields: [storeId], references: [id])
  cashier        User         @relation(fields: [cashierId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  orderItems     OrderItem[]
  payments       Payment[]

  @@map("orders")
}

model OrderItem {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  variantId      String         @map("variant_id") @db.Uuid
  quantity       Decimal        @db.Decimal(12, 3)
  unitCost       Decimal        @map("unit_cost") @db.Decimal(12, 4)
  unitRetail     Decimal        @map("unit_retail") @db.Decimal(12, 4)
  taxRate        Decimal        @map("tax_rate") @db.Decimal(5, 2)
  discountAmount Decimal        @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal      Decimal        @map("line_total") @db.Decimal(12, 2)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  paymentMethod         PaymentMethod @map("payment_method")
  amount                Decimal       @db.Decimal(12, 2)
  tenderedAmount        Decimal?      @map("tendered_amount") @db.Decimal(12, 2)
  changeReturned        Decimal       @default(0.00) @map("change_returned") @db.Decimal(12, 2)
  externalTransactionId String?       @map("external_transaction_id") @db.VarChar(100)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz

  order                 Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model CashShift {
  id           String      @id @default(uuid()) @db.Uuid
  storeId      String      @map("store_id") @db.Uuid
  cashierId    String      @map("cashier_id") @db.Uuid
  openingTime  DateTime    @default(now()) @map("opening_time") @db.Timestamptz
  closingTime  DateTime?   @map("closing_time") @db.Timestamptz
  openingFloat Decimal     @map("opening_float") @db.Decimal(12, 2)
  expectedCash Decimal?    @map("expected_cash") @db.Decimal(12, 2)
  actualCash   Decimal?    @map("actual_cash") @db.Decimal(12, 2)
  discrepancy  Decimal?    @db.Decimal(12, 2)
  status       ShiftStatus @default(open)

  store        Store       @relation(fields: [storeId], references: [id])
  cashier      User        @relation(fields: [cashierId], references: [id])

  @@map("cash_shifts")
}